# Copy this file to backend/.env and fill in real values.
#   PowerShell:  Copy-Item .env.example .env
# backend/.env is git-ignored and must be created on every machine.

PORT=5000

# MongoDB connection string.
# Atlas: Cluster -> Connect -> Drivers -> copy the string, then replace
# <username>/<password> and put your database name after the host.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?appName=Cluster0

# Secret used to sign JWTs. Use a long random value, unique per environment.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRE=30d

NODE_ENV=development

# Optional, development only. When MONGODB_URI is unreachable, allow falling back
# to a local mongod at mongodb://127.0.0.1:27017/recruitai.
# Leave false: an empty local database makes valid logins fail and silently
# discards registrations. Ignored when NODE_ENV=production.
ALLOW_LOCAL_DB_FALLBACK=false